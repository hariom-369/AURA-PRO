# --- Core ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>
# Optional — MongoDB connection pool size. Defaults to 10 if unset.
MONGO_MAX_POOL_SIZE=10
JWT_SECRET=your_jwt_secret_key
CLIENT_URL=http://localhost:5173

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- Media Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (Resend) ---
# Order emails (confirmation, status updates, low-stock alerts) AND password
# reset emails. Get a key at https://resend.com/api-keys — see docs/EMAIL.md
# for full setup, including the required sending-domain verification step
# (Resend will not deliver from an unverified domain). Order emails are
# best-effort (silently skipped if unset); password-reset emails are the one
# place this matters for a core flow — see docs/AUTHENTICATION.md.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_ADDRESS=orders@aurapro.com
EMAIL_FROM_NAME=AURA PRO

# --- AI (Google Gemini) ---
# Required for the AI shopping assistant, semantic search, recommendations,
# comparison, review summarization, description generator, and support assistant.
# Get a key at https://aistudio.google.com/apikey — the models below are
# pinned to ones confirmed free-tier (see docs/AI.md); this app never
# silently falls back to a paid model.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Set to true only if Atlas Vector Search / a vector index is enabled on your
# MongoDB cluster; otherwise semantic search runs as structured-filter extraction
# over normal MongoDB queries and this flag should stay false.
AI_VECTOR_SEARCH_ENABLED=false

# --- Frontend origin allowed for admin-only cross-origin requests, if separate from CLIENT_URL ---
ADMIN_URL=http://localhost:5173

# --- Google Sign-In (see docs/AUTHENTICATION.md) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application. Same public Client ID
# is used on both frontend (VITE_GOOGLE_CLIENT_ID) and backend — the backend
# uses it only as the expected `audience` when verifying a Google ID token,
# never as a secret. No client secret is needed: Google Identity Services'
# token-based sign-in flow doesn't use the OAuth code-exchange flow.
# Leave unset to disable Google sign-in entirely (email/password still works).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Cloudflare Turnstile (bot protection on register/login/forgot-password —
# see docs/AUTHENTICATION.md) ---
# From the Cloudflare dashboard -> Turnstile -> Add a site. Secret key is
# backend-only, never exposed to the frontend. Leave unset to disable
# Turnstile enforcement entirely (useful for local development); production
# should always have this set.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# --- Multi-vendor marketplace ---
# 32-byte key (as 64 hex characters) used to encrypt seller payout bank
# details at rest (AES-256-GCM — see server/utils/encryption.js). Generate
# one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required before any seller submits payout information; without it those
# endpoints fail closed with a 503 rather than storing anything insecurely.
# Rotating this key makes previously-encrypted payout data unreadable — treat
# it like any other long-lived secret (back it up, never commit it).
PAYOUT_ENCRYPTION_KEY=

# Default marketplace commission percentage applied to seller order items
# that don't have their own Seller.commissionPercent override.
MARKETPLACE_DEFAULT_COMMISSION_PERCENT=10
