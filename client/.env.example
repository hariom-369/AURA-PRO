# Base URL of the backend API. Defaults to http://localhost:5000/api/v1 if unset.
VITE_API_URL=http://localhost:5000/api/v1

# Firebase Phone Authentication (additive alternative to email/password login
# — see docs/FIREBASE_AUTH.md). These are Firebase's public web-app config
# values, not secrets by Firebase's own security model — but still not
# hardcoded, and the "Continue with phone number" button only appears when
# all four are set. From Firebase Console -> Project settings -> General ->
# Your apps -> (web app) -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
