# Base URL of the backend API. Defaults to http://localhost:5000/api/v1 if unset.
VITE_API_URL=http://localhost:5000/api/v1

# Google Sign-In (see docs/AUTHENTICATION.md). Public Client ID, not a
# secret — from Google Cloud Console -> APIs & Services -> Credentials.
# The "Continue with Google" button only appears when this is set; leave
# blank to disable Google sign-in entirely (email/password still works).
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Cloudflare Turnstile (see docs/AUTHENTICATION.md). Public Site Key, not a
# secret — from the Cloudflare dashboard -> Turnstile. The verification
# widget only renders when this is set; leave blank to disable Turnstile
# enforcement entirely (useful for local development).
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
